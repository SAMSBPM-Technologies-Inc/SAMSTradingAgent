# ── Production environment template ────────────────────────────────────────────
# Copy to .env.production on the Hetzner server and fill in real values.
# NEVER commit .env.production to git.

# ── MongoDB ─────────────────────────────────────────────────────────────────────
# Self-hosted (Docker on same server) — use the container name as hostname:
MONGODB_URL=mongodb://mongo:27017
# OR MongoDB Atlas — replace with your Atlas connection string:
# MONGODB_URL=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=trading_agent

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────────
# Get this from: Cloudflare dashboard → Zero Trust → Networks → Tunnels
# → Create a tunnel → copy the token shown in the Docker run command
CLOUDFLARE_TUNNEL_TOKEN=

# ── API Keys ─────────────────────────────────────────────────────────────────────
# All of these are injected from GitHub Secrets on every deploy
# (inject_key_guarded in .github/workflows/deploy.yml), so a value left blank
# here is filled in by the first deploy. They are listed anyway: a fresh box
# provisioned by hand from this template needs to know they exist, and a key
# that is simply absent degrades silently rather than erroring.
FINNHUB_API_KEY=
FRED_API_KEY=
ANTHROPIC_API_KEY=
# Fundamentals providers. Without these the fundamental score falls back to a
# flat 0.5 and the research layer has no company data — no statements, no
# business description, no earnings history.
MASSIVE_API_KEY=
ALPHAVANTAGE_API_KEY=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# ── App ──────────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
INGESTION_INTERVAL_MINUTES=5

# ── Tickers ──────────────────────────────────────────────────────────────────────
DEFAULT_TICKERS=PLTR,AAPL,TSLA,NVDA,MSFT

# ── CORS — set to your actual frontend domain(s) ─────────────────────────────────
# Examples:
#   CORS_ORIGINS=https://trading.yourdomain.com
#   CORS_ORIGINS=https://trading.yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=https://trading.yourdomain.com

# ── Automated Trading — Interactive Brokers ───────────────────────────────────────
# Step 1: Open an IBKR account at interactivebrokers.ca
# Step 2: Set TWS_USERID and TWS_PASSWORD to your IBKR login credentials
#         For paper trading: use paper account credentials from Client Portal
#         Settings → Paper Trading → Paper Account credentials (different from live login)
# Step 3: Set AUTO_TRADE_ENABLED=true once IB Gateway container is confirmed healthy
#
# CIRO NOTE: Only US-listed tickers (NYSE/NASDAQ) are permitted via API.
# Canadian-exchange securities are blocked automatically by the trading service.
#
# IBKR_HOST is injected by docker-compose (ibgateway service name).
# Only override here if you run IB Gateway outside of Docker.
#
# ⚠️  PORT TRAP — the #1 cause of "connects to nothing":
#     Inside the ib-gateway container, IB Gateway binds its API to 127.0.0.1
#     ONLY (4001 live / 4002 paper). Those are unreachable from the api
#     container. socat republishes them on 0.0.0.0 as 4003 (live) / 4004 (paper).
#     → IBKR_PORT must be 4004 (paper) or 4003 (live). Never 4001/4002.

# Execution venue: ibkr (IB Gateway) | alpaca (REST, no gateway process)
BROKER_PROVIDER=ibkr

# IB Gateway Docker container credentials (native env var names — passed directly, no mapping).
#
# NOTE: when deploying via GitHub Actions these are written for you. CI holds
# both credential pairs as secrets and selects one from TRADING_MODE:
#     paper -> TWS_USERID_PAPER / TWS_PASSWORD_PAPER  (relay port 4004)
#     live  -> TWS_USERID       / TWS_PASSWORD        (relay port 4003)
# The selected pair lands here as TWS_USERID / TWS_PASSWORD, which is what the
# gateway image reads. Set them by hand only for a non-CI deployment.
TWS_USERID=
TWS_PASSWORD=
TRADING_MODE=paper            # paper | live  (live also requires AUTO_TRADE_LIVE_ALLOWED=true)
IBKR_PORT=4004                # 4004=paper relay, 4003=live relay. MUST match TRADING_MODE.
IBKR_CLIENT_ID=1
IBKR_ACCOUNT_ID=              # optional; blank = default account
VNC_SERVER_PASSWORD=changeme-vnc  # password for VNC remote debug access (optional)

# Master kill-switch — false by default; flip to true only after confirming IB Gateway is healthy.
# While false the app makes NO broker connection at all and places no orders.
AUTO_TRADE_ENABLED=false
AUTO_TRADE_LIVE_ALLOWED=false

# ── Alternative venue: Alpaca (only used when BROKER_PROVIDER=alpaca) ─────────────
# No gateway process, no daily re-auth, no 2FA. US equities only.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# ── Feature flags ─────────────────────────────────────────────────────────────────
ENABLE_AI_ANALYST=true
ENABLE_ML_MODEL=true
ENABLE_BACKTESTING=false

# ── AI Analyst — Claude model config ──────────────────────────────────────────────
# claude-opus-4-6: highest finance benchmark score (default, recommended)
# claude-sonnet-4-6: ~5x cheaper per token, good for high-volume / cost-sensitive use
ANALYST_MODEL=claude-opus-4-6
# Extended thinking: Claude reasons through conflicting signals before answering.
# Adds ~3-8s per analysis but produces better calibrated signals. Set false to disable.
ANALYST_EXTENDED_THINKING=true

# ── AI Analyst caching — controls when Claude is re-called vs serving cached signal ───
# Claude is only called when one of these triggers fires; otherwise existing signal is kept.
# Default settings reduce Claude calls by ~90% vs calling every pipeline cycle.
ANALYST_CACHE_MINUTES=60          # re-analyze unconditionally after this many minutes
ANALYST_PRICE_CHANGE_PCT=0.03     # re-analyze if price moves >=3% since last analysis
ANALYST_SCORE_CHANGE_THRESHOLD=0.12  # re-analyze if composite score shifts >=0.12
ANALYST_VIX_SPIKE_THRESHOLD=30.0  # re-analyze everything when VIX >= 30 (fear regime)

# ── Scoring weights (must sum to 1.0) ─────────────────────────────────────────────
WEIGHT_TECHNICAL=0.25
WEIGHT_FUNDAMENTAL=0.15
WEIGHT_SENTIMENT=0.20
WEIGHT_MACRO=0.15
WEIGHT_VOLATILITY=0.10
WEIGHT_CATALYST=0.15
