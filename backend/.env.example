# MongoDB Atlas Connection
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=trading_agent

# App Settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Job Settings (minutes)
INGESTION_INTERVAL_MINUTES=5

# Default tickers to track (comma-separated)
DEFAULT_TICKERS=PLTR,AAPL,TSLA,NVDA,MSFT

# ── Fundamentals providers ───────────────────────────────────────────────────
# Both are required for the fundamental score to carry real signal, and for the
# research layer to have any company data at all. yfinance is NOT a fallback
# here any more — it 429s from the deploy host, which is what pinned
# fundamental_score at its 0.5 default for every ticker.
#
# NOTE the variable name. This file previously said ALPHA_VANTAGE_KEY, which
# nothing reads — config.py declares `alphavantage_api_key`, so the env var is
# ALPHAVANTAGE_API_KEY. Setting the old name looked correct and silently left
# the provider unconfigured.
#
# Massive (Polygon.io) — financial statements, ~5 req/min.
MASSIVE_API_KEY=
# Alpha Vantage — OVERVIEW ratios, business description, EARNINGS history.
# Free tier: 25 calls/day, which is smaller than a typical watchlist. See
# ALPHAVANTAGE_DAILY_BUDGET and the earnings cache settings below.
ALPHAVANTAGE_API_KEY=

# Phase 1: Real data sources
# Finnhub — free tier, 60 calls/min. Get key at https://finnhub.io/
# Required for real news sentiment. Falls back to neutral (0.5) if absent.
FINNHUB_API_KEY=

# FRED (Federal Reserve) — free, unlimited. Get key at https://fred.stlouisfed.org/docs/api/api_key.html
# Required for macro data (rates, CPI, unemployment, VIX). Degrades gracefully if absent.
FRED_API_KEY=

# Phase 3: AI Analyst (Claude)
# Get your key at https://console.anthropic.com/
# Cost: ~$0.01–0.05 per ticker analysis
ANTHROPIC_API_KEY=

# Feature flags
ENABLE_ML_MODEL=false
ENABLE_BACKTESTING=false
ENABLE_AI_ANALYST=false

# ── Deep research (agent orchestrator) ────────────────────────────────────────
# A second, slower analysis path: four scoped agents over one shared evidence
# ledger, then a synthesiser. Five model calls per dossier, so it runs on demand
# and once a day — never on the 5-minute pipeline.
RESEARCH_AGENTS_ENABLED=false
RESEARCH_ORCHESTRATOR_MODEL=claude-opus-5
RESEARCH_SPECIALIST_MODEL=claude-sonnet-5
RESEARCH_EFFORT=high
RESEARCH_DOSSIER_TTL_HOURS=24
RESEARCH_DAILY_REFRESH_HOUR=6

# Research may BLOCK a buy. It can never create one, enlarge one, or touch an
# exit. A missing or stale dossier never vetoes — fail-open, so a scheduler
# outage cannot silently halt trading.
RESEARCH_VETO_ENABLED=false
RESEARCH_VETO_MIN_CONVICTION=35
RESEARCH_VETO_MAX_AGE_HOURS=48

# Earnings history moves quarterly, so it is cached for a week rather than a
# day — the Alpha Vantage budget covers OVERVIEW and EARNINGS between them and
# cannot do both for every ticker daily. A ticker about to report is refreshed
# eagerly regardless of cache age.
ALPHAVANTAGE_EARNINGS_CACHE_DAYS=7
ALPHAVANTAGE_EARNINGS_EAGER_DAYS=7

# ── Contact form ──────────────────────────────────────────────────────────────
# Where the landing page's contact form delivers. Sending itself uses the same
# SMTP_* settings as trade alerts (unset by default — leave SMTP_HOST empty and
# the endpoint reports a delivery failure rather than pretending to send).
CONTACT_EMAIL=contact@samsbpm.com
