# MongoDB Atlas Connection
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=trading_agent

# App Settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Job Settings (minutes)
INGESTION_INTERVAL_MINUTES=5

# Default tickers to track (comma-separated)
DEFAULT_TICKERS=PLTR,AAPL,TSLA,NVDA,MSFT

# ── Fundamentals providers ───────────────────────────────────────────────────
# Both are required for the fundamental score to carry real signal, and for the
# research layer to have any company data at all. yfinance is NOT a fallback
# here any more — it 429s from the deploy host, which is what pinned
# fundamental_score at its 0.5 default for every ticker.
#
# NOTE the variable name. This file previously said ALPHA_VANTAGE_KEY, which
# nothing reads — config.py declares `alphavantage_api_key`, so the env var is
# ALPHAVANTAGE_API_KEY. Setting the old name looked correct and silently left
# the provider unconfigured.
#
# Massive (Polygon.io) — financial statements, ~5 req/min.
MASSIVE_API_KEY=
# Alpha Vantage — OVERVIEW ratios, business description, EARNINGS history.
# Free tier: 25 calls/day, which is smaller than a typical watchlist. See
# ALPHAVANTAGE_DAILY_BUDGET and the earnings cache settings below.
ALPHAVANTAGE_API_KEY=

# Phase 1: Real data sources
# Finnhub — free tier, 60 calls/min. Get key at https://finnhub.io/
# Required for real news sentiment. Falls back to neutral (0.5) if absent.
FINNHUB_API_KEY=

# FRED (Federal Reserve) — free, unlimited. Get key at https://fred.stlouisfed.org/docs/api/api_key.html
# Required for macro data (rates, CPI, unemployment, VIX). Degrades gracefully if absent.
FRED_API_KEY=

# Phase 3: AI Analyst (Claude)
# Get your key at https://console.anthropic.com/
# Cost: ~$0.01–0.05 per ticker analysis
ANTHROPIC_API_KEY=

# Feature flags
ENABLE_ML_MODEL=false
ENABLE_BACKTESTING=false
ENABLE_AI_ANALYST=false

# ── Deep research (agent orchestrator) ────────────────────────────────────────
# A second, slower analysis path: four scoped agents over one shared evidence
# ledger, then a synthesiser. Five model calls per dossier, so it runs on demand
# and once a day — never on the 5-minute pipeline.
RESEARCH_AGENTS_ENABLED=false
RESEARCH_ORCHESTRATOR_MODEL=claude-opus-5
RESEARCH_SPECIALIST_MODEL=claude-sonnet-5
RESEARCH_EFFORT=high
RESEARCH_DOSSIER_TTL_HOURS=24
RESEARCH_DAILY_REFRESH_HOUR=6

# Judge a score against the rest of the watchlist rather than against a fixed
# cutoff. The composite clusters near 0.567 with a realistic ceiling around
# 0.75 against a 0.70 BUY threshold, so an absolute cutoff mostly selects for
# how much data happened to be available. A BUY then needs the top fifth of
# the field AND an absolute floor of 0.55 — the floor is what can still say
# "nothing here is worth owning". Exits are unaffected: ranking may add one,
# never withdraw one.
#
# OFF by default and worth turning on deliberately — it changes which names
# the agent buys, and nothing has yet measured whether it ranks outcomes
# better. Give it ~20 trading days and read /performance/calibration.
ENABLE_RANK_SIGNALS=false

# Research may BLOCK a buy. It can never create one, enlarge one, or touch an
# exit. A missing or stale dossier never vetoes — fail-open, so a scheduler
# outage cannot silently halt trading.
RESEARCH_VETO_ENABLED=false
RESEARCH_VETO_MIN_CONVICTION=35
RESEARCH_VETO_MAX_AGE_HOURS=48

# Earnings history moves quarterly, so it is cached for a week rather than a
# day — the Alpha Vantage budget covers OVERVIEW and EARNINGS between them and
# cannot do both for every ticker daily. A ticker about to report is refreshed
# eagerly regardless of cache age.
ALPHAVANTAGE_EARNINGS_CACHE_DAYS=7
ALPHAVANTAGE_EARNINGS_EAGER_DAYS=7

# ── Contact form ──────────────────────────────────────────────────────────────
# Where the landing page's contact form delivers. Sending itself uses the same
# SMTP_* settings as trade alerts (unset by default — leave SMTP_HOST empty and
# the endpoint reports a delivery failure rather than pretending to send).
CONTACT_EMAIL=contact@samsbpm.com

# ── Access tiers ──────────────────────────────────────────────────────────────
# Who the operator is. Comma-separated; matched case-insensitively against the
# account's email. An empty value makes NOBODY an admin — which fails closed,
# but also means provisioning silently stops working, so `_check_admin_email`
# logs loudly at startup when it is empty or matches no account.
#
# Deliberately NOT injected by .github/workflows/deploy.yml, for the same reason
# CONTACT_EMAIL is not: `_set_key` writes `KEY=` for an unset variable, and an
# empty admin address is worse than a defaulted one. Set it here or leave the
# default in config.py.
ADMIN_EMAIL=sudheer.samudrala@samsbpm.com

# How many tickers each plan covers. This is the real cost control in the
# system: every watched ticker joins the union the pipeline re-runs every five
# minutes on this deployment's own keys, and that spend cannot be attributed to
# a user because the scored document is shared. Traders are uncapped; an
# operator can still cap an individual account from /admin.
TIER_WATCHLIST_CAP_BASIC=5
TIER_WATCHLIST_CAP_PRO=15

# Full-analysis runs (`/analyze?force_refresh=true`) per user per day. A quota
# rather than an entitlement: the analyst call inside the pipeline carries no
# user id, so this spend belongs to the deployment however it was triggered.
# In-process — the counter resets when the api container restarts.
ANALYSIS_RUNS_PER_DAY=25

# ── Password recovery ─────────────────────────────────────────────────────────
# Where a reset link points — the web client's origin, not the API's.
#
# Configured rather than derived from the request on purpose: a Host header is
# attacker-controlled, and building a reset link out of one is how a reset email
# ends up pointing at somebody else's site.
#
# Reset by email needs SMTP_* set. Without it POST /auth/forgot-password says so
# plainly (503) rather than accepting requests it could never deliver — the
# operator can still reset a password by hand from /admin.
PUBLIC_BASE_URL=https://sta.samsbpm.com

# ── Scaling into a position ───────────────────────────────────────────────────
# Both are rate limits wearing price and size conditions, because a standing BUY
# verdict re-runs the entry path every five-minute cycle — deliberately, so a
# skip for "gateway down" retries — and every add costs a commission.
#
# Stated here because the defaults are easy to get wrong from memory and the
# consequences point in opposite directions: too shallow a dip adds into noise,
# too large a fraction silences a small account entirely. Neither applies to an
# opening entry, which has no alternative, and neither touches exits.
#
# How far under the position's blended cost an add must be. Measured against
# blended entry, which falls after each add, so adds are self-spacing.
SCALE_IN_DIP_PCT=0.02
# An add must be at least this fraction of what is already held, or it moves the
# position too little to carry its commission. A fraction rather than a dollar
# figure so it scales with the account.
MIN_ADD_FRACTION=0.25
# Hard ceiling on adds per position: the dip gate bounds *where* adds happen,
# this bounds how many times you can pay to find out.
MAX_SCALE_INS=2
